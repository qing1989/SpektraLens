<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/noto_sans_sc_variable</item>
        <item name="android:colorAccent">#F0523D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0A0A0B</item>
        <item name="android:navigationBarColor">#0A0A0B</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#0A0A0B</item>
        <item name="android:colorBackground">#0A0A0B</item>
        <item name="android:colorBackgroundFloating">#121214</item>
        <item name="android:textColorPrimary">#F4F4F6</item>
        <item name="android:textColorSecondary">#8E8E95</item>
        <item name="android:colorControlHighlight">#24FFFFFF</item>
        <item name="android:alertDialogTheme">@style/SpektraLensDialogTheme</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:scrollbars">none</item>
        <item name="android:scrollbarSize">0dp</item>
        <item name="android:scrollbarThumbVertical">@null</item>
        <item name="android:scrollbarTrackVertical">@null</item>
        <item name="android:scrollbarThumbHorizontal">@null</item>
        <item name="android:scrollbarTrackHorizontal">@null</item>
    </style>
    <style name="SpektraLensDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/noto_sans_sc_variable</item>
        <item name="android:colorAccent">#F0523D</item>
        <item name="android:colorBackgroundFloating">#121214</item>
        <item name="android:colorBackground">#121214</item>
        <item name="android:textColorPrimary">#F4F4F6</item>
        <item name="android:textColorSecondary">#8E8E95</item>
        <item name="android:colorControlHighlight">#24FFFFFF</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:textAppearanceListItem">@style/SpektraLensListText</item>
        <item name="android:textAppearanceListItemSmall">@style/SpektraLensListText</item>
        <item name="android:scrollbars">none</item>
        <item name="android:scrollbarSize">0dp</item>
        <item name="android:scrollbarThumbVertical">@null</item>
        <item name="android:scrollbarTrackVertical">@null</item>
        <item name="android:scrollbarThumbHorizontal">@null</item>
        <item name="android:scrollbarTrackHorizontal">@null</item>
    </style>
    <style name="SpektraLensListText" parent="android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#F4F4F6</item>
        <item name="android:fontFamily">@font/noto_sans_sc_variable</item>
    </style>
    <style name="GallerySheetAnimation">
        <item name="android:windowEnterAnimation">@anim/gallery_sheet_in</item>
    </style>
</resources>
