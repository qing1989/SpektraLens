+// base   this dispatch's first element inside its binding window
+// origin where that window starts in the frame (absolute index = origin + base + local)
+// read_bias how many elements the window starts before the band, for kernels
+//           whose reads reach outside the rows they write
+layout(push_constant) uniform SpkDispatch { uint base; uint origin; uint read_bias; uint count; } spk_pc;
+
+// CAM16-UCS output gamut compression, transferred from gamut.metal.
+// Matrix buffers are row-major here; the baked c_max table is (nL, nh).
+layout(local_size_x = 256) in;
+layout(set = 0, binding = 0, std430) readonly buffer Input { float value[]; } input_data;
+layout(set = 0, binding = 1, std430) readonly buffer ToXyz { float value[]; } m2x;
+layout(set = 0, binding = 2, std430) readonly buffer ToRgb { float value[]; } m2r;
+layout(set = 0, binding = 3, std430) readonly buffer CMax { float value[]; } cmax;
+layout(set = 0, binding = 4, std430) readonly buffer Constants { float value[]; } constants;
+layout(set = 0, binding = 5, std430) readonly buffer Meta { uint value[]; } meta;
+layout(set = 0, binding = 6, std430) writeonly buffer Output { float value[]; } output_data;
+
+#ifdef SPK_VIEW_STATS
+layout(set = 0, binding = 7, std430) buffer Stats { uint value[]; } stats;
+#endif
+
+// vulkan_gpu.cpp folds a dispatch past maxComputeWorkGroupCount[0] (65535 on
+// lavapipe and Intel) into rows of workgroups; this is the 1D index it means.
+uint spk_global_index() {
+    return spk_pc.base + gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
+}
+
+// Frame-absolute index: where this invocation sits in the whole frame, not in
+// its binding window. Kernels that derive a random seed or a spatial gradient
+// from the index must use this one, or a band would restart the noise.
+uint spk_frame_index() {
+    return spk_pc.origin + spk_pc.base +
+           gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) +
+           gl_GlobalInvocationID.x;
+}
+
+void main() {
+    // Dispatch windows may end inside a workgroup. Never touch padding lanes.
+    if (gl_GlobalInvocationID.y*(gl_NumWorkGroups.x*gl_WorkGroupSize.x)+gl_GlobalInvocationID.x >= spk_pc.count) return;
+    uint i = spk_global_index();
+    if (i >= meta.value[0]) return;
+    uint nL = meta.value[1], nh = meta.value[2], lc_active = meta.value[3];
+    float F_L = constants.value[0], N_bb = constants.value[1];
+    float N_cb = constants.value[2], n_value = constants.value[3];
+    float z = constants.value[4], A_w = constants.value[5];
+    float c_value = constants.value[6], N_c = constants.value[7];
+    float L_grid0 = constants.value[8], L_grid1 = constants.value[9];
+    float h_grid0 = constants.value[10], h_step = constants.value[11];
