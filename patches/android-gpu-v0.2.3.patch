diff --git a/engine/src/pipeline/tiling.hpp b/engine/src/pipeline/tiling.hpp
new file mode 100644
--- /dev/null
+++ b/engine/src/pipeline/tiling.hpp
@@ -0,0 +1,55 @@
+// Android row-window adapter, GPL-3.0-or-later.
+// Implements the missing helper required by the SAINTTaiYi v1.3.3j GPU patch.
+// Strides are explicit; a pooled allocation's capacity never defines a layout.
+#pragma once
+#include "pipeline.hpp"
+#include <algorithm>
+#include <cstdlib>
+#include <limits>
+
+namespace spk {
+inline bool dispatch_tiled(gpu::Gpu* gpu, const char* kernel,
+                           const std::vector<gpu::Arg>& args,
+                           const std::vector<uint32_t>& strides, const Image& shape,
+                           size_t elements, std::string& error,
+                           const std::vector<uint32_t>& halo = {}, uint32_t origin = 0) {
+    if (!elements) return true;
+    if (!shape.h || elements % shape.h || strides.size() != args.size()) {
+        error = std::string(kernel) + ": invalid row-window layout"; return false;
+    }
+    const size_t columns = elements / shape.h;
+    if (!columns || columns > UINT32_MAX || elements > UINT32_MAX) {
+        error = std::string(kernel) + ": row-window index exceeds uint32"; return false;
+    }
+    const uint64_t limit = gpu->max_storage_buffer_range();
+    std::vector<gpu::Arg> logical(args);
+    bool split = elements > (1ull << 24);
+    uint64_t row_cap = (1ull << 24) / columns;
+    for (size_t i=0;i<args.size();++i) {
+        if (!strides[i]) continue;
+        if (!args[i].buffer || elements > UINT64_MAX / strides[i]) {
+            error = std::string(kernel) + ": invalid window buffer"; return false;
+        }
+        logical[i].range = uint64_t(elements) * strides[i];
+        if (limit) {
+            split |= logical[i].range > limit;
+            uint64_t rows = limit / (columns * strides[i]);
+            const uint64_t context = halo.size()>i ? uint64_t(halo[i])*2 : 0;
+            row_cap = std::min(row_cap, rows>context ? rows-context : 0);
+        }
+    }
+    uint64_t requested=512;
+    if (const char* value=std::getenv("SPK_FORCE_BAND_ROWS")) {
+        const long n=std::strtol(value,nullptr,10);
+        if(n>0){requested=uint64_t(n);split=true;}
+    }
+    if (!split) return gpu->dispatch_at(kernel,logical,elements,origin,error);
+    if (origin) { error=std::string(kernel)+": nested frame windows are unsupported";return false; }
+    if (!row_cap) { error=std::string(kernel)+": one row and halo exceed maxStorageBufferRange";return false; }
+    gpu::TilePlan plan;
+    plan.rows=shape.h;plan.columns=uint32_t(columns);
+    plan.band_rows=uint32_t(std::min({requested,row_cap,uint64_t(shape.h)}));
+    plan.stride=strides;plan.halo=halo;
+    return gpu->dispatch_banded(kernel,logical,elements,plan,error);
+}
+} // namespace spk
