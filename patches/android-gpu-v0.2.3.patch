diff --git a/engine/src/shaders/vulkan/spk_split_probe.comp b/engine/src/shaders/vulkan/spk_split_probe.comp
new file mode 100644
--- /dev/null
+++ b/engine/src/shaders/vulkan/spk_split_probe.comp
@@ -0,0 +1,15 @@
+#version 450
+#extension GL_GOOGLE_include_directive : require
+#include "spk_split_product.glsl"
+
+// Same split product as the IIR and geometry kernels. The host checks both
+// returned words against a binary64 oracle, with no acceptance tolerance.
+layout(local_size_x = 1) in;
+layout(set = 0, binding = 0, std430) readonly buffer Input { float value[]; } input_data;
+layout(set = 0, binding = 1, std430) writeonly buffer Output { float value[]; } output_data;
+void main() {
+    uint i = gl_GlobalInvocationID.y * gl_NumWorkGroups.x + gl_GlobalInvocationID.x;
+    vec2 product = spk_split_product(input_data.value[2 * i], input_data.value[2 * i + 1]);
+    output_data.value[2 * i] = product.x;
+    output_data.value[2 * i + 1] = product.y;
+}
diff --git a/engine/src/shaders/vulkan/spk_split_product.glsl b/engine/src/shaders/vulkan/spk_split_product.glsl
new file mode 100644
--- /dev/null
+++ b/engine/src/shaders/vulkan/spk_split_product.glsl
@@ -0,0 +1,13 @@
+// Error-free product for bounded normal inputs, without relying on fma.
+// Keep these operations precise: reassociation loses the low word.
+vec2 spk_split_product(float a, float b) {
+    precise float p = a * b;
+    precise float ca = 4097.0 * a;
+    precise float ahi = ca - (ca - a);
+    precise float alo = a - ahi;
+    precise float cb = 4097.0 * b;
+    precise float bhi = cb - (cb - b);
+    precise float blo = b - bhi;
+    precise float e = ((ahi * bhi - p) + ahi * blo + alo * bhi) + alo * blo;
+    return vec2(p, e);
+}
